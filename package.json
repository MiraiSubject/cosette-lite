{
    "private": true,
    "scripts": {
        "dev": "pnpm --filter cosette-lite dev",
        "dev:osu-proxy": "pnpm --filter osu-api-proxy dev",
        "lint": "pnpm --filter cosette-lite lint",
        "build": "pnpm --filter cosette-lite build",
        "check": "pnpm --filter cosette-lite check",
        "format": "prettier --write \"**/*.{ts,tsx,md}\""
    },
    "dependencies": {
        "dotenv-cli": "^7.3.0"
    },
    "pnpm": {
        "overrides": {
            "cookie": "0.7.2",
            "defu": "6.1.5",
            "flatted": "3.4.2",
            "picomatch": "4.0.4",
            "undici": "7.24.0",
            "wrangler": "4.59.1",
            "ws": "8.20.1"
        }
    }
}
